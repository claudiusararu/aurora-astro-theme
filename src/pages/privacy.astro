---
import Layout from "~/layouts/Layout.astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import LegalContent from "~/components/LegalContent.astro";
---

<Layout title="Privacy Policy - Aurora" description="Read the Aurora privacy policy.">
  <Header />
  <main id="main">
    <section class="relative overflow-hidden border-b border-line-soft">
      <div class="container-content py-24 md:py-32 text-center">
        <p class="reveal text-eyebrow mb-4">SAAS STARTER</p>
        <h1 class="reveal text-display-sm md:text-display max-w-[18ch] mx-auto" style="letter-spacing: -0.04em;">Privacy Policy</h1>
        <p class="reveal mt-6 text-[1.05rem] md:text-[1.2rem] leading-relaxed text-soft max-w-[54ch] mx-auto" data-delay="1">Read the Aurora privacy policy.</p>
      </div>
    </section>
    <LegalContent heading="Privacy Policy" />
  </main>
  <Footer />
</Layout>
