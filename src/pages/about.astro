---
import Layout from "~/layouts/Layout.astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import Stats from "~/components/Stats.astro";
import Team from "~/components/Team.astro";
import Timeline from "~/components/Timeline.astro";
import Testimonials from "~/components/Testimonials.astro";
import CTA from "~/components/CTA.astro";
---

<Layout title="About Aurora - Aurora" description="Aurora is designed as a complete starter website, not just a landing page.">
  <Header />
  <main id="main">
    <section class="relative overflow-hidden border-b border-line-soft">
      <div class="container-content py-24 md:py-32 text-center">
        <p class="reveal text-eyebrow mb-4">SAAS STARTER</p>
        <h1 class="reveal text-display-sm md:text-display max-w-[18ch] mx-auto" style="letter-spacing: -0.04em;">About Aurora</h1>
        <p class="reveal mt-6 text-[1.05rem] md:text-[1.2rem] leading-relaxed text-soft max-w-[54ch] mx-auto" data-delay="1">Aurora is designed as a complete starter website, not just a landing page.</p>
      </div>
    </section>
    <Stats />
    <Team />
    <Timeline />
    <Testimonials />
    <CTA />
  </main>
  <Footer />
</Layout>
