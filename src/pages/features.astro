---
import Layout from "~/layouts/Layout.astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import LogoCloud from "~/components/LogoCloud.astro";
import Features from "~/components/Features.astro";
import Stats from "~/components/Stats.astro";
import ImageText from "~/components/ImageText.astro";
import Tabs from "~/components/Tabs.astro";
import Video from "~/components/Video.astro";
import AppDownload from "~/components/AppDownload.astro";
import FAQ from "~/components/FAQ.astro";
import CTA from "~/components/CTA.astro";
---

<Layout title="Features - Aurora" description="All the pieces your SaaS needs to explain, convert, and support users.">
  <Header />
  <main id="main">
    <section class="relative overflow-hidden border-b border-line-soft">
      <div class="container-content py-24 md:py-32 text-center">
        <p class="reveal text-eyebrow mb-4">SAAS STARTER</p>
        <h1 class="reveal text-display-sm md:text-display max-w-[18ch] mx-auto" style="letter-spacing: -0.04em;">
          Features
        </h1>
        <p class="reveal mt-6 text-[1.05rem] md:text-[1.2rem] leading-relaxed text-soft max-w-[54ch] mx-auto" data-delay="1">
          All the pieces your SaaS needs to explain, convert, and support users.
        </p>
      </div>
    </section>
    <LogoCloud />
    <Features />
    <Stats />
    <ImageText />
    <Tabs />
    <Video />
    <AppDownload />
    <FAQ />
    <CTA />
  </main>
  <Footer />
</Layout>
