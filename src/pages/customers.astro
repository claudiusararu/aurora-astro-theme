---
import Layout from "~/layouts/Layout.astro";
import { siteConfig } from "~/config/site";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import LogoCloud from "~/components/LogoCloud.astro";
import Testimonials from "~/components/Testimonials.astro";
import Stats from "~/components/Stats.astro";
import Carousel from "~/components/Carousel.astro";
import CTA from "~/components/CTA.astro";
---

<Layout title="Customers - Aurora" description="Trust signals, proof, stories, and customer-facing conversion sections.">
  <Header />
  <main id="main">
    <section class="relative overflow-hidden border-b border-line-soft">
      <div class="container-content py-24 md:py-32 text-center">
        <p class="reveal text-eyebrow mb-4">{siteConfig.pageHeaders.customers.eyebrow}</p>
        <h1 class="reveal text-display-sm md:text-display max-w-[18ch] mx-auto" style="letter-spacing: -0.04em;">
          {siteConfig.pageHeaders.customers.title}
        </h1>
        <p class="reveal mt-6 text-[1.05rem] md:text-[1.2rem] leading-relaxed text-soft max-w-[54ch] mx-auto" data-delay="1">
          {siteConfig.pageHeaders.customers.subtitle}
        </p>
      </div>
    </section>
    <LogoCloud />
    <Testimonials />
    <Stats />
    <Carousel />
    <CTA />
  </main>
  <Footer />
</Layout>
