---
import Layout from "~/layouts/Layout.astro";
import { siteConfig } from "~/config/site";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import Contact from "~/components/Contact.astro";
import Map from "~/components/Map.astro";
import FAQ from "~/components/FAQ.astro";
import CTA from "~/components/CTA.astro";
---

<Layout title="Contact - Aurora" description="Get in touch with the Aurora team.">
  <Header />
  <main id="main">
    <section class="relative overflow-hidden border-b border-line-soft">
      <div class="container-content py-24 md:py-32 text-center">
        <p class="reveal text-eyebrow mb-4">{siteConfig.pageHeaders.contact.eyebrow}</p>
        <h1 class="reveal text-display-sm md:text-display max-w-[18ch] mx-auto" style="letter-spacing: -0.04em;">{siteConfig.pageHeaders.contact.title}</h1>
        <p class="reveal mt-6 text-[1.05rem] md:text-[1.2rem] leading-relaxed text-soft max-w-[54ch] mx-auto" data-delay="1">{siteConfig.pageHeaders.contact.subtitle}</p>
      </div>
    </section>
    <Contact />
    <Map />
    <FAQ />
    <CTA />
  </main>
  <Footer />
</Layout>
