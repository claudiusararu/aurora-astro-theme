---
interface TimelineEvent {
  year: string;
  title: string;
  description: string;
}

const defaultEvents: TimelineEvent[] = [
  {
    year: "2021",
    title: "The beginning",
    description: "Founded with a simple idea: project management should feel invisible. Two engineers, one apartment, zero funding.",
  },
  {
    year: "2022",
    title: "First 1,000 users",
    description: "Launched the public beta. Word spread through engineering communities. Reached product-market fit within six months.",
  },
  {
    year: "2023",
    title: "Series A",
    description: "Raised $12M to scale the platform. Expanded the team to 25. Shipped real-time collaboration and API access.",
  },
  {
    year: "2024",
    title: "Enterprise ready",
    description: "SOC 2 certified. SSO, audit logs, and advanced permissions. Serving teams from 5 to 5,000 members.",
  },
];

const {
  heading = "Our journey",
  subheading = "From a two-person team to powering thousands of workflows.",
  timelineItems = defaultEvents,
} = Astro.props as {
  heading?: string;
  subheading?: string;
  timelineItems?: TimelineEvent[];
};

const events = timelineItems.length ? timelineItems : defaultEvents;
---

<section class="relative py-20 md:py-28">
  <div class="container-content">
    <div class="reveal mb-14 md:mb-18 text-center max-w-2xl mx-auto">
      <h2
        class="text-[1.8rem] md:text-[2.4rem] font-bold leading-[1.05] text-strong"
        style="letter-spacing: -0.04em;"
      >
        {heading}
      </h2>
      <p class="mt-5 text-[1.05rem] text-soft max-w-[40ch] mx-auto">
        {subheading}
      </p>
    </div>

    <div class="relative max-w-3xl mx-auto">
      <!-- Center line -->
      <div
        class="absolute left-1/2 top-0 bottom-0 w-px bg-line-soft -translate-x-1/2 hidden md:block"
        aria-hidden="true"
      ></div>

      <div class="space-y-12 md:space-y-0">
        {
          events.map((event, i) => {
            const isLeft = i % 2 === 0;
            return (
              <div
                class={`reveal relative md:flex items-start ${
                  isLeft ? "md:flex-row" : "md:flex-row-reverse"
                }`}
                data-delay={Math.min(i + 1, 6)}
              >
                {/* Content */}
                <div class={`pl-7 md:w-1/2 md:pl-0 ${isLeft ? "md:pr-12 md:text-right" : "md:pl-12"}`}>
                  <span class="text-[12px] font-semibold text-muted uppercase tracking-[0.08em]">
                    {event.year}
                  </span>
                  <h3
                    class="mt-2 text-[1.1rem] font-bold text-strong"
                    style="letter-spacing: -0.02em;"
                  >
                    {event.title}
                  </h3>
                  <p class="mt-2 text-[14px] leading-relaxed text-soft max-w-[36ch] inline-block">
                    {event.description}
                  </p>
                </div>

                {/* Dot */}
                <div class="hidden md:flex absolute left-1/2 top-1 -translate-x-1/2 items-center justify-center">
                  <div class="w-3 h-3 rounded-full bg-strong border-2 border-bg"></div>
                </div>

                {/* Spacer for opposite side */}
                <div class="hidden md:block md:w-1/2" />

                {/* Mobile dot */}
                <div class="md:hidden absolute left-0 top-1 w-2.5 h-2.5 rounded-full bg-strong" aria-hidden="true" />
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
