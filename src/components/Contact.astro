---
import Icon from "~/components/Icon.astro";
import { siteConfig } from "~/config/site";

const {
  heading = "Get in touch",
  subheading = "Have a question or want to learn more? We'd love to hear from you.",
  nameLabel = "Name",
  emailLabel = "Email",
  subjectLabel = "Subject",
  messageLabel = "Message",
  buttonLabel = "Send message",
  contactEmail = "hello@aurora.io",
  contactPhone = "+1 (555) 123-4567",
  office = "123 Innovation Drive\nSan Francisco, CA 94107",
  responseNote = "We typically respond within 24 hours during business days.",
} = Astro.props as {
  heading?: string;
  subheading?: string;
  nameLabel?: string;
  emailLabel?: string;
  subjectLabel?: string;
  messageLabel?: string;
  buttonLabel?: string;
  contactEmail?: string;
  contactPhone?: string;
  office?: string;
  responseNote?: string;
};

// ─── Form provider wiring ──────────────────────────────────
// Reads siteConfig.contactForm.provider and produces the right
// action / method / hidden inputs for the chosen service.
// If provider is null or misconfigured, falls back to a mailto:
// action so the form still does something useful.
const cf = siteConfig.contactForm as {
  provider: "formspree" | "formsubmit" | "netlify" | null;
  formspreeId?: string;
  formsubmitEmail?: string;
};

const formName = "contact";
let action: string | undefined;
let method: "POST" | "GET" = "POST";
let netlify = false;

if (cf.provider === "formspree" && cf.formspreeId) {
  action = `https://formspree.io/f/${cf.formspreeId}`;
} else if (cf.provider === "formsubmit" && cf.formsubmitEmail) {
  action = `https://formsubmit.co/${cf.formsubmitEmail}`;
} else if (cf.provider === "netlify") {
  // Netlify Forms detects the data-netlify attribute and the form name.
  // The action stays on the current page; Netlify takes over the POST.
  netlify = true;
} else {
  // Fallback: plain mailto so the button still does something.
  action = `mailto:${contactEmail}`;
  method = "GET";
}
---

<section class="relative py-20 md:py-28">
  <div class="container-content">
    <div class="reveal mb-14 md:mb-18 max-w-2xl">
      <h2
        class="text-[1.8rem] md:text-[2.4rem] font-bold leading-[1.05] text-strong"
        style="letter-spacing: -0.04em;"
      >
        {heading}
      </h2>
      <p class="mt-5 text-[1.05rem] text-soft max-w-[48ch]">
        {subheading}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      <!-- Form -->
      <div class="lg:col-span-7">
        <form
          class="reveal space-y-5"
          data-delay="1"
          name={formName}
          method={method}
          action={action}
          {...(netlify ? { "data-netlify": "true" } : {})}
        >
          {netlify && (
            <input type="hidden" name="form-name" value={formName} />
          )}
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="contact-name" class="block text-[13px] font-medium text-strong mb-2">
                {nameLabel}
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                placeholder="Your name"
                class="w-full px-4 py-3 bg-bg border border-line-soft text-strong text-[14px] placeholder:text-muted outline-none transition-colors duration-200 focus:border-strong"
                style="border-radius: 8px;"
              />
            </div>
            <div>
              <label for="contact-email" class="block text-[13px] font-medium text-strong mb-2">
                {emailLabel}
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                placeholder="you@company.com"
                class="w-full px-4 py-3 bg-bg border border-line-soft text-strong text-[14px] placeholder:text-muted outline-none transition-colors duration-200 focus:border-strong"
                style="border-radius: 8px;"
              />
            </div>
          </div>

          <div>
            <label for="contact-subject" class="block text-[13px] font-medium text-strong mb-2">
              {subjectLabel}
            </label>
            <input
              type="text"
              id="contact-subject"
              name="subject"
              placeholder="How can we help?"
              class="w-full px-4 py-3 bg-bg border border-line-soft text-strong text-[14px] placeholder:text-muted outline-none transition-colors duration-200 focus:border-strong"
              style="border-radius: 8px;"
            />
          </div>

          <div>
            <label for="contact-message" class="block text-[13px] font-medium text-strong mb-2">
              {messageLabel}
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              required
              placeholder="Tell us more about your project..."
              class="w-full px-4 py-3 bg-bg border border-line-soft text-strong text-[14px] placeholder:text-muted outline-none transition-colors duration-200 focus:border-strong resize-none"
              style="border-radius: 8px;"
            ></textarea>
          </div>

          <button
            type="submit"
            class="btn btn-brand btn-lg"
            style="border-radius: 8px;"
          >
            {buttonLabel}
            <Icon name="send" size={15} class="text-current opacity-80" />
          </button>
        </form>
      </div>

      <!-- Contact info -->
      <div class="lg:col-span-5">
        <div class="reveal sticky top-24 space-y-8" data-delay="2">
          <div class="flex items-start gap-4">
            <div
              class="shrink-0 w-10 h-10 flex items-center justify-center bg-elevated"
              style="border-radius: 8px;"
            >
              <Icon name="send" size={16} class="text-strong" />
            </div>
            <div>
              <h3 class="text-[14px] font-semibold text-strong">Email</h3>
              <a
                href={`mailto:${contactEmail}`}
                class="mt-1 block text-[14px] text-soft hover:text-strong transition-colors duration-200"
              >
                {contactEmail}
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div
              class="shrink-0 w-10 h-10 flex items-center justify-center bg-elevated"
              style="border-radius: 8px;"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="text-strong" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z" />
              </svg>
            </div>
            <div>
              <h3 class="text-[14px] font-semibold text-strong">Phone</h3>
              <a
                href={`tel:${contactPhone.replace(/[^+\d]/g, "")}`}
                class="mt-1 block text-[14px] text-soft hover:text-strong transition-colors duration-200"
              >
                {contactPhone}
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div
              class="shrink-0 w-10 h-10 flex items-center justify-center bg-elevated"
              style="border-radius: 8px;"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="text-strong" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </div>
            <div>
              <h3 class="text-[14px] font-semibold text-strong">Office</h3>
              <p class="mt-1 text-[14px] text-soft leading-relaxed">
                {office.split("\n").map((line) => (
                  <>
                    {line}<br />
                  </>
                ))}
              </p>
            </div>
          </div>

          <div class="pt-6 border-t border-line-soft">
            <p class="text-[13px] text-muted">
              {responseNote}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
