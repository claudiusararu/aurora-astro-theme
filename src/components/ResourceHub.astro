---
import { siteConfig } from "~/config/site";

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
}

const {
  eyebrow = siteConfig.resourceHub.eyebrow,
  title = siteConfig.resourceHub.heading,
  description = siteConfig.resourceHub.subheading,
} = Astro.props;
const cards = siteConfig.resourceHub.cards;
---

<section class="py-16 md:py-24 border-b border-line-soft">
  <div class="container-content">
    <div class="grid gap-10 lg:grid-cols-[0.42fr_1fr] lg:items-start">
      <div class="reveal">
        <p class="text-eyebrow mb-4">{eyebrow}</p>
        <h2 class="text-display-sm max-w-[12ch]" style="letter-spacing: -0.04em;">{title}</h2>
        <p class="mt-5 text-[1rem] md:text-[1.1rem] leading-relaxed text-soft max-w-[44ch]">{description}</p>
      </div>

      <div class="grid gap-4 md:grid-cols-3">
        {cards.map((card, index) => (
          <article class="reveal rounded-2xl border border-line-soft bg-surface p-5 md:p-6" data-delay={String(index + 1)}>
            <div class="mb-5 inline-flex h-10 w-10 items-center justify-center rounded-xl border border-line-soft bg-bg text-[0.8rem] font-bold text-strong">
              {String(index + 1).padStart(2, "0")}
            </div>
            <h3 class="text-[1.05rem] font-bold text-strong" style="letter-spacing: -0.015em;">{card.title}</h3>
            <p class="mt-3 text-[0.92rem] leading-relaxed text-soft">{card.description}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
