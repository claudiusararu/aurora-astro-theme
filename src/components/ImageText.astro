---
import Icon from "~/components/Icon.astro";

type ImageTextLayout = "image-right" | "image-left";
type ImageTextVisual = "analytics" | "monitoring";
type ImageAsset = string | { url?: string; alt?: string } | null | undefined;

interface Props {
  layout?: ImageTextLayout;
  visualType?: ImageTextVisual;
  image?: ImageAsset;
  eyebrow?: string;
  heading?: string;
  body?: string;
  checklist?: string | string[];
  checks?: string | string[];
  learnMoreLabel?: string;
  learnMoreUrl?: string;
}

const {
  layout = "image-right",
  visualType = "analytics",
  image = null,
  eyebrow = "INTELLIGENCE",
  heading = "Feature intelligence built for modern product teams",
  body = "Understand how features perform from the moment they ship. Track adoption curves, identify friction points, and measure real impact on your product metrics, all in one place.",
  checklist = "",
  checks = "",
  learnMoreLabel = "Learn more",
  learnMoreUrl = "#learn",
} = Astro.props;

const imageUrl = typeof image === "string" ? image : image?.url;
const imageAlt = typeof image === "object" && image?.alt ? image.alt : "";
const checklistValue = checklist || checks;
const checklistItems = Array.isArray(checklistValue)
  ? checklistValue.filter(Boolean)
  : checklistValue.split("\n").map((item) => item.trim()).filter(Boolean);
const imageFirst = layout === "image-left";
const visualOrder = imageFirst ? "order-2 lg:order-1" : "order-2 lg:order-2";
const copyOrder = imageFirst ? "order-1 lg:order-2" : "order-1 lg:order-1";
const showLearnMore = learnMoreLabel.trim() && learnMoreUrl.trim();
---

<section class="relative py-24 md:py-32">
  <div class="container-content">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-20 items-center">
      <div class:list={["reveal", visualOrder]} data-delay={imageFirst ? undefined : "2"}>
        {
          imageUrl ? (
            <div class="bg-bg border border-line-soft rounded-xl overflow-hidden" style="border-radius: 12px;">
              <img src={imageUrl} alt={imageAlt} class="aspect-[4/3] w-full object-cover" loading="lazy" decoding="async" />
            </div>
          ) : visualType === "monitoring" ? (
            <div class="bg-bg border border-line-soft rounded-xl overflow-hidden" style="border-radius: 12px;">
              <div class="flex items-center justify-between px-5 py-3 border-b border-line-soft">
                <div class="flex items-center gap-2">
                  <Icon name="shield" size={13} class="text-strong" />
                  <span class="text-[11px] font-semibold text-strong">Monitoring</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full" style="background: oklch(50% 0.15 155); box-shadow: 0 0 0 3px oklch(50% 0.15 155 / 0.2);"></span>
                  <span class="text-[9px] font-mono" style="color: oklch(50% 0.15 155);">All systems normal</span>
                </div>
              </div>

              <div class="p-5 space-y-3">
                <div class="grid grid-cols-2 gap-3">
                  {
                    [
                      { label: "Uptime", value: "98%", helper: "Last 90 days", color: "oklch(50% 0.15 155)", offset: "2.3" },
                      { label: "Health Score", value: "85", helper: "Across services", color: "var(--color-strong)", offset: "16.97" },
                    ].map((metric) => (
                      <div class="p-3 bg-surface rounded-lg flex items-center gap-3" style="border-radius: 8px;">
                        <div class="relative">
                          <svg width="44" height="44" viewBox="0 0 44 44" aria-hidden="true">
                            <circle cx="22" cy="22" r="18" stroke="var(--color-line-soft)" stroke-width="3.5" fill="none" />
                            <circle cx="22" cy="22" r="18" stroke={metric.color} stroke-width="3.5" fill="none" stroke-dasharray="113.1" stroke-dashoffset={metric.offset} stroke-linecap="round" transform="rotate(-90 22 22)" />
                          </svg>
                          <div class="absolute inset-0 flex items-center justify-center">
                            <span class="text-[11px] font-bold text-strong text-tabular">{metric.value}</span>
                          </div>
                        </div>
                        <div>
                          <div class="text-[10px] font-semibold text-strong">{metric.label}</div>
                          <div class="text-[8px] text-muted mt-0.5">{metric.helper}</div>
                        </div>
                      </div>
                    ))
                  }
                </div>

                <div class="bg-surface rounded-lg overflow-hidden" style="border-radius: 8px;">
                  <div class="px-3.5 py-2 border-b border-line-soft">
                    <span class="text-[9px] font-medium text-muted uppercase tracking-wider">Recent Alerts</span>
                  </div>
                  {
                    [
                      { message: "Deployment completed successfully", time: "2m ago", type: "success" },
                      { message: "High memory usage on worker-03", time: "18m ago", type: "warning" },
                      { message: "SSL certificate renewed", time: "1h ago", type: "success" },
                      { message: "API latency spike resolved", time: "3h ago", type: "info" },
                      { message: "Database backup completed", time: "6h ago", type: "success" },
                    ].map((alert) => (
                      <div class="flex items-center gap-3 px-3.5 py-2 border-b border-line-soft last:border-b-0">
                        <span
                          class="w-1.5 h-1.5 rounded-full shrink-0"
                          style={`background: ${
                            alert.type === "success"
                              ? "oklch(50% 0.15 155)"
                              : alert.type === "warning"
                                ? "oklch(70% 0.16 70)"
                                : "var(--color-muted)"
                          };`}
                        ></span>
                        <span class="text-[10px] text-strong flex-1">{alert.message}</span>
                        <span class="text-[8px] font-mono text-muted shrink-0">{alert.time}</span>
                      </div>
                    ))
                  }
                </div>

                <div class="flex items-center gap-2">
                  {["View Logs", "Run Diagnostics", "Export Report"].map((action) => (
                    <span class="flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-surface text-[9px] font-medium text-soft" style="border-radius: 8px;">
                      {action}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <div class="bg-bg border border-line-soft rounded-xl overflow-hidden" style="border-radius: 12px;">
              <div class="flex items-center justify-between px-5 py-3 border-b border-line-soft">
                <div class="flex items-center gap-2">
                  <Icon name="gauge" size={13} class="text-strong" />
                  <span class="text-[11px] font-semibold text-strong">Feature Analytics</span>
                </div>
                <span class="text-[9px] font-mono text-muted">Last 30 days</span>
              </div>

              <div class="p-5 space-y-4">
                <div class="grid grid-cols-3 gap-3">
                  {
                    [
                      ["Adoption Rate", "78.4%", "+12.3%"],
                      ["Active Users", "14.2K", "+8.7%"],
                      ["Avg. Session", "6m 42s", "+2.1%"],
                    ].map(([label, value, delta]) => (
                      <div class="p-3 bg-surface rounded-lg" style="border-radius: 8px;">
                        <div class="text-[8px] text-muted uppercase tracking-wider font-medium">{label}</div>
                        <div class="text-[18px] font-bold text-strong mt-1 text-tabular" style="letter-spacing: -0.03em;">{value}</div>
                        <div class="text-[8px] font-medium mt-0.5" style="color: oklch(50% 0.15 155);">{delta}</div>
                      </div>
                    ))
                  }
                </div>

                <div class="bg-surface rounded-lg p-4" style="border-radius: 8px;">
                  <div class="flex items-center justify-between mb-3">
                    <span class="text-[10px] font-semibold text-strong">Feature Adoption Trend</span>
                    <div class="flex items-center gap-3">
                      <span class="flex items-center gap-1 text-[8px] text-muted">
                        <span class="w-2 h-0.5 rounded-full bg-strong"></span>
                        This month
                      </span>
                      <span class="flex items-center gap-1 text-[8px] text-muted">
                        <span class="w-2 h-0.5 rounded-full" style="background: var(--color-line);"></span>
                        Last month
                      </span>
                    </div>
                  </div>
                  <svg class="w-full" viewBox="0 0 320 100" fill="none" aria-hidden="true">
                    <line x1="0" y1="25" x2="320" y2="25" stroke="var(--color-line-soft)" stroke-width="0.5" stroke-dasharray="4 4" />
                    <line x1="0" y1="50" x2="320" y2="50" stroke="var(--color-line-soft)" stroke-width="0.5" stroke-dasharray="4 4" />
                    <line x1="0" y1="75" x2="320" y2="75" stroke="var(--color-line-soft)" stroke-width="0.5" stroke-dasharray="4 4" />
                    <path d="M0,70 L46,65 L92,68 L138,55 L184,50 L230,48 L276,42 L320,38" stroke="var(--color-line)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M0,65 L46,55 L92,50 L138,38 L184,30 L230,22 L276,18 L320,12 L320,100 L0,100 Z" fill="oklch(18% 0.005 280 / 0.04)" />
                    <path d="M0,65 L46,55 L92,50 L138,38 L184,30 L230,22 L276,18 L320,12" stroke="var(--color-strong)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="320" cy="12" r="3" fill="var(--color-strong)" />
                    <circle cx="320" cy="12" r="6" fill="oklch(18% 0.005 280 / 0.12)" />
                  </svg>
                  <div class="flex justify-between mt-2 text-[7px] font-mono text-muted">
                    <span>Week 1</span><span>Week 2</span><span>Week 3</span><span>Week 4</span>
                  </div>
                </div>

                <div class="space-y-1.5">
                  {
                    [
                      { name: "Smart Search", adoption: 92, delta: "+5%" },
                      { name: "Batch Actions", adoption: 74, delta: "+18%" },
                      { name: "Custom Views", adoption: 61, delta: "+12%" },
                    ].map((feature) => (
                      <div class="flex items-center gap-3 px-3 py-2 bg-surface rounded-lg" style="border-radius: 8px;">
                        <span class="text-[10px] font-medium text-strong flex-1">{feature.name}</span>
                        <div class="w-20 h-1.5 bg-elevated rounded-full overflow-hidden">
                          <div class="h-full rounded-full bg-strong" style={`width: ${feature.adoption}%;`}></div>
                        </div>
                        <span class="text-[9px] font-mono text-muted w-8 text-right">{feature.adoption}%</span>
                        <span class="text-[8px] font-medium w-8 text-right" style="color: oklch(50% 0.15 155);">{feature.delta}</span>
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>
          )
        }
      </div>

      <div class:list={["reveal", copyOrder]} data-delay={imageFirst ? "2" : undefined}>
        {eyebrow && (
          <div class="text-eyebrow mb-4" style="color: var(--color-strong); font-family: var(--font-sans); font-weight: 600; letter-spacing: 0.08em;">
            {eyebrow}
          </div>
        )}
        <h2
          class="text-[1.8rem] md:text-[2.2rem] font-bold leading-[1.08] text-strong max-w-[22ch]"
          style="letter-spacing: -0.04em;"
        >
          {heading}
        </h2>
        <p class="mt-6 text-[1rem] leading-relaxed text-soft max-w-[46ch]">
          {body}
        </p>

        {checklistItems.length > 0 && (
          <ul class="mt-8 space-y-4">
            {checklistItems.map((item) => (
              <li class="flex items-start gap-3 text-[0.95rem] text-soft">
                <Icon name="check" size={17} class="shrink-0 mt-0.5 text-strong" stroke={2} />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        )}

        {showLearnMore && (
          <a
            href={learnMoreUrl}
            class="inline-flex items-center gap-2 mt-8 text-[14px] font-semibold text-strong hover:opacity-70 transition-opacity duration-200 group"
          >
            {learnMoreLabel}
            <Icon
              name="arrow-right"
              size={14}
              class="transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-x-0.5"
            />
          </a>
        )}
      </div>
    </div>
  </div>
</section>
