---
import { siteConfig } from "~/config/site";

type StatItem = {
  value?: string;
  label?: string;
};

interface Props {
  statItems?: StatItem[];
  items?: string;
}

const defaultStats = siteConfig.stats.items;

const {
  statItems = [],
  items = "",
} = Astro.props;

const structuredStats = statItems
  .map((item) => ({
    value: item.value ?? "",
    label: item.label ?? "",
  }))
  .filter((item) => item.value || item.label);

const legacyStats = items
  .split("\n")
  .map((line) => line.trim())
  .filter(Boolean)
  .map((line) => {
    const [value = "", label = ""] = line.split("|").map((part) => part.trim());
    return { value, label };
  });

const stats = structuredStats.length > 0 ? structuredStats : legacyStats.length > 0 ? legacyStats : defaultStats;
---

<section class="relative py-20 md:py-28 bg-surface">
  <div class="container-content">
    <div class="flex flex-wrap gap-8 md:gap-0" style="justify-content: center;">
      {
        stats.map((stat, i) => (
          <div
            class={`reveal min-w-[10rem] text-left ${
              i > 0 ? "md:border-l md:border-line-soft md:pl-10" : ""
            } ${i < stats.length - 1 ? "md:pr-10" : ""}`}
            data-delay={Math.min(i + 1, 6)}
          >
            <div
              class="w-12 mb-6 border-t-2 border-strong"
              aria-hidden="true"
            ></div>
            <div
              class="text-[2.5rem] md:text-[3rem] font-bold text-strong leading-none text-tabular"
              style="letter-spacing: -0.04em;"
            >
              {stat.value}
            </div>
            <div class="mt-3 text-[11px] font-semibold text-muted uppercase tracking-[0.1em]">
              {stat.label}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
