---
import Icon from "~/components/Icon.astro";
import { siteConfig } from "~/config/site";

type FeatureIconName =
  | "search"
  | "grid"
  | "globe"
  | "gauge"
  | "layers"
  | "clock"
  | "rocket"
  | "sparkle"
  | "code"
  | "image"
  | "palette"
  | "send";

type FeatureItem = {
  icon?: FeatureIconName;
  title?: string;
  description?: string;
};

interface Props {
  heading?: string;
  items?: string;
  featureItems?: FeatureItem[];
  sectionId?: string;
}

const iconNames: FeatureIconName[] = [
  "search",
  "grid",
  "globe",
  "gauge",
  "layers",
  "clock",
  "rocket",
  "sparkle",
  "code",
  "image",
  "palette",
  "send",
];

const defaultFeatures = siteConfig.features.items;

const {
  heading = siteConfig.features.heading,
  items = "",
  featureItems,
  sectionId = "features",
} = Astro.props;

function isFeatureIcon(value: unknown): value is FeatureIconName {
  return typeof value === "string" && iconNames.includes(value as FeatureIconName);
}

function fallbackIcon(index: number): FeatureIconName {
  return iconNames[index % iconNames.length] ?? "search";
}

function normalizeFeature(item: FeatureItem, index: number): Required<FeatureItem> {
  return {
    icon: isFeatureIcon(item.icon) ? item.icon : fallbackIcon(index),
    title: item.title ?? "",
    description: item.description ?? "",
  };
}

function parseFeatureLine(line: string, index: number): Required<FeatureItem> {
  const parts = line.split("|").map((part) => part.trim());
  const hasIcon = parts.length >= 3 && isFeatureIcon(parts[0]);
  return {
    icon: hasIcon ? parts[0] : fallbackIcon(index),
    title: hasIcon ? parts[1] ?? "" : parts[0] ?? "",
    description: hasIcon ? parts.slice(2).join("|") : parts.slice(1).join("|"),
  };
}

const customFeatures = Array.isArray(featureItems)
  ? featureItems.map(normalizeFeature).filter((feature) => feature.title || feature.description)
  : [];

const parsedFeatures = items
  .split("\n")
  .map((line) => line.trim())
  .filter(Boolean)
  .map(parseFeatureLine)
  .filter((feature) => feature.title || feature.description);

const features = customFeatures.length > 0 ? customFeatures : parsedFeatures.length > 0 ? parsedFeatures : defaultFeatures;
---

<section id={sectionId} class="relative py-24 md:py-32">
  <div class="container-content">
    <div class="reveal mb-16 md:mb-20 max-w-2xl">
      <h2
        class="text-[1.8rem] md:text-[2.4rem] font-bold leading-[1.05] text-strong"
        style="letter-spacing: -0.04em;"
      >
        {heading}
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-line-soft" style="border-radius: 12px; overflow: hidden; border: 1px solid var(--color-line-soft);">
      {
        features.map((feature, i) => (
          <article
            class="reveal bg-bg p-8 md:p-10"
            data-delay={Math.min(i + 1, 6)}
          >
            <div
              class="inline-flex items-center justify-center w-10 h-10 rounded-lg mb-6"
              style="background: var(--color-elevated);"
            >
              <Icon name={feature.icon as any} size={18} stroke={1.6} class="text-strong" />
            </div>

            <h3
              class="text-[1rem] font-semibold text-strong"
              style="letter-spacing: -0.02em;"
            >
              {feature.title}
            </h3>

            <p class="mt-3 text-[0.9rem] leading-relaxed text-soft">
              {feature.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
