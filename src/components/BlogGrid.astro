---
import { siteConfig } from "~/config/site";

interface Props {
  posts: Array<{
    id: string;
    data: {
      title: string;
      description: string;
      date: Date;
      author: string;
      category: string;
      image?: string;
    };
  }>;
}

const { posts } = Astro.props;

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(date);
}
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  {
    posts.length === 0
    ? <p class="text-[0.95rem] text-soft">{siteConfig.blog.emptyState}</p>
    : posts.map((post, i) => (
      <a
        href={`/blog/${post.id.replace(/\.md$/, "")}/`}
        class="reveal group bg-bg border border-line-soft rounded-xl overflow-hidden hover:shadow-soft transition-all duration-300"
        data-delay={Math.min(i + 1, 6)}
      >
        <div class="aspect-[16/10] bg-elevated overflow-hidden">
          {post.data.image ? (
            <img
              src={post.data.image}
              alt={post.data.title}
              class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)]"
              loading="lazy"
            />
          ) : (
            <div class="w-full h-full aurora-gradient-bg-subtle" />
          )}
        </div>

        <div class="p-6">
          <span class="inline-block px-2 py-0.5 rounded text-[11px] font-mono uppercase tracking-wider text-muted bg-elevated">
            {post.data.category}
          </span>

          <h3
            class="text-[1.05rem] font-semibold text-strong mt-3 group-hover:opacity-70 transition-opacity duration-200"
            style="letter-spacing: -0.02em;"
          >
            {post.data.title}
          </h3>

          <p class="text-[0.875rem] text-soft mt-2 leading-relaxed line-clamp-2">
            {post.data.description}
          </p>

          <div class="flex items-center gap-2 text-[0.8rem] text-muted mt-4">
            <span>{post.data.author}</span>
            <span aria-hidden="true">&middot;</span>
            <time datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
          </div>
        </div>
      </a>
    ))
  }
</div>
