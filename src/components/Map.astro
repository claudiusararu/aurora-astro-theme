---
import Icon from "~/components/Icon.astro";
import { siteConfig } from "~/config/site";

interface LocationItem {
  city: string;
  address: string;
  phone: string;
  email: string;
}

const defaultLocations = siteConfig.map.locations as readonly LocationItem[];

const {
  heading = siteConfig.map.heading,
  subheading = siteConfig.map.subheading,
  mapMode = siteConfig.map.mapMode,
  mapEmbedUrl = siteConfig.map.mapEmbedUrl,
  mapLabel = siteConfig.map.mapLabel,
  locationItems = defaultLocations,
} = Astro.props as {
  heading?: string;
  subheading?: string;
  mapMode?: "auto" | "embed" | "placeholder" | string;
  mapEmbedUrl?: string;
  mapLabel?: string;
  locationItems?: LocationItem[];
};

const locations = locationItems.length ? locationItems : defaultLocations;

function normalizeMapEmbedUrl(url: string) {
  const trimmed = url.trim();
  if (!trimmed) return "";
  try {
    const parsed = new URL(trimmed);
    const host = parsed.hostname.toLowerCase();
    const allowedGoogle = (host === "www.google.com" || host === "maps.google.com") && parsed.pathname.includes("/maps");
    const allowedOsm = host === "www.openstreetmap.org" && parsed.pathname.includes("/export/embed");
    return allowedGoogle || allowedOsm ? trimmed : "";
  } catch {
    return "";
  }
}

function autoMapUrl(items: readonly LocationItem[]) {
  const first = items[0];
  const query = [first?.city, first?.address].filter(Boolean).join(", ").trim();
  return query ? `https://www.google.com/maps?q=${encodeURIComponent(query)}&output=embed` : "";
}

const resolvedMapMode = mapMode === "embed" || mapMode === "placeholder" ? mapMode : "auto";
const resolvedMapUrl = resolvedMapMode === "placeholder"
  ? ""
  : resolvedMapMode === "embed"
    ? normalizeMapEmbedUrl(mapEmbedUrl)
    : autoMapUrl(locations);
---

<section class="relative py-20 md:py-28">
  <div class="container-content">
    <div class="reveal mb-14 md:mb-18 max-w-2xl">
      <h2
        class="text-[1.8rem] md:text-[2.4rem] font-bold leading-[1.05] text-strong"
        style="letter-spacing: -0.04em;"
      >
        {heading}
      </h2>
      <p class="mt-5 text-[1.05rem] text-soft max-w-[44ch]">
        {subheading}
      </p>
    </div>

    <div class="reveal" data-delay="1">
      <div
        class="relative overflow-hidden bg-surface border border-line-soft"
        style="border-radius: 12px; aspect-ratio: 21 / 9;"
      >
        {resolvedMapUrl ? (
          <iframe
            src={resolvedMapUrl}
            title={mapLabel}
            class="absolute inset-0 h-full w-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        ) : (
          <>
            <div class="absolute inset-0 dot-grid opacity-40" aria-hidden="true"></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="flex flex-col items-center gap-2">
                <svg
                  width="32"
                  height="32"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-strong"
                  aria-hidden="true"
                >
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
                <span class="text-[12px] font-medium text-muted">{mapLabel}</span>
              </div>
            </div>
          </>
        )}
      </div>
    </div>

    <!-- Location cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-0 mt-6 border border-line-soft overflow-hidden" style="border-radius: 12px;">
      {
        locations.map((loc, i) => (
          <article
            class={`reveal p-7 md:p-8 bg-bg ${
              i < locations.length - 1 ? "border-b md:border-b-0 md:border-r border-line-soft" : ""
            }`}
            data-delay={Math.min(i + 2, 6)}
          >
            <h3
              class="text-[1.05rem] font-bold text-strong"
              style="letter-spacing: -0.02em;"
            >
              {loc.city}
            </h3>

            <div class="mt-4 space-y-3">
              <div class="flex items-start gap-2.5">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5 text-muted" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
                <span class="text-[13px] text-soft leading-snug">{loc.address}</span>
              </div>

              <div class="flex items-center gap-2.5">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-muted" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z" />
                </svg>
                <span class="text-[13px] text-soft">{loc.phone}</span>
              </div>

              <div class="flex items-center gap-2.5">
                <Icon name="send" size={14} class="shrink-0 text-muted" />
                <a href={`mailto:${loc.email}`} class="text-[13px] text-soft hover:text-strong transition-colors duration-200">
                  {loc.email}
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
