---
import Icon from "~/components/Icon.astro";

type BackgroundMode = "default" | "color" | "image";
type LayoutType = "centered" | "centered-no-image" | "split-right" | "split-left";
type ImageValue = string | { url?: string; alt?: string } | null | undefined;

interface Props {
  eyebrow?: string;
  heading?: string;
  headingSize?: number;
  subheading?: string;
  subheadingSize?: number;
  textColor?: string;
  layoutType?: LayoutType;
  backgroundMode?: BackgroundMode;
  backgroundColor?: string;
  backgroundImage?: ImageValue;
  heroImage?: ImageValue;
  primaryCtaEnabled?: boolean;
  primaryCta?: string;
  primaryCtaUrl?: string;
  secondaryCtaEnabled?: boolean;
  secondaryCta?: string;
  secondaryCtaUrl?: string;
}

const {
  eyebrow = "",
  heading = "Optimize your workflow.\nAccelerate your growth.",
  headingSize = 96,
  subheading = "The modern platform that helps teams move faster, stay organized, and deliver results without the complexity.",
  subheadingSize = 19,
  textColor = "#07070b",
  layoutType = "centered",
  backgroundMode = "default",
  backgroundColor = "#ffffff",
  backgroundImage = null,
  heroImage = null,
  primaryCtaEnabled = true,
  primaryCta = "Start for free",
  primaryCtaUrl = "#start",
  secondaryCtaEnabled = true,
  secondaryCta = "Watch demo",
  secondaryCtaUrl = "#demo",
} = Astro.props;

function imageUrl(value: ImageValue) {
  if (!value) return "";
  if (typeof value === "string") return value;
  return value.url ?? "";
}

const backgroundUrl = imageUrl(backgroundImage);
const heroImageUrl = imageUrl(heroImage);
const heroImageAlt = typeof heroImage === "object" && heroImage?.alt ? heroImage.alt : "Hero image";
const isSplit = layoutType === "split-right" || layoutType === "split-left";
const showCenteredImage = layoutType !== "centered-no-image";
const heroPadding = isSplit
  ? ["padding-top: 7rem", "padding-bottom: 7rem"]
  : ["padding-top: 6rem", "padding-bottom: 12rem"];
const backgroundStyle = [
  ...heroPadding,
  backgroundMode === "color" ? `background: ${backgroundColor}` : "",
  backgroundMode === "image" && backgroundUrl ? `background-image: url('${backgroundUrl.replace(/'/g, "%27")}')` : "",
  backgroundMode === "image" && backgroundUrl ? "background-size: cover" : "",
  backgroundMode === "image" && backgroundUrl ? "background-position: center" : "",
].filter(Boolean).join("; ");

const headingLines = heading.split("\n");
---

<section class="relative overflow-hidden">
  <!-- Aurora gradient background -->
  <div class:list={[backgroundMode === "default" && "aurora-gradient-bg-subtle"]} style={backgroundStyle}>
    <div class:list={[
      "container-wide relative",
      isSplit ? "grid items-center gap-12 md:grid-cols-2" : "text-center",
    ]}>
      <div class:list={[
        isSplit ? "text-center md:text-left" : "",
        layoutType === "split-left" && "md:order-2",
      ]}>
      {eyebrow.trim() && (
        <p
          class="reveal mb-5 text-[0.72rem] font-semibold uppercase tracking-[0.16em]"
          style={`color: ${textColor}; opacity: 0.72;`}
        >
          {eyebrow}
        </p>
      )}
      <!-- Centered heading -->
      <h1
        class="reveal max-w-[16ch] mx-auto"
        style={`letter-spacing: -0.04em; color: ${textColor}; font-size: clamp(2.25rem, 5vw, ${headingSize / 16}rem); line-height: 0.92; font-weight: 800;`}
      >
        {headingLines.map((line, index) => (
          <>
            {index > 0 && <br />}
            {line}
          </>
        ))}
      </h1>

      <p
        class="reveal mt-7 leading-relaxed max-w-[48ch] mx-auto"
        style={`color: ${textColor}; opacity: 0.7; font-size: clamp(1rem, 1.8vw, ${subheadingSize / 16}rem);`}
        data-delay="1"
      >
        {subheading}
      </p>

      <div class="reveal mt-9 flex flex-wrap items-center justify-center gap-3" data-delay="2">
        {primaryCtaEnabled && (
          <a
            href={primaryCtaUrl}
            class="btn btn-brand btn-lg group"
            style="border-radius: 8px;"
          >
            {primaryCta}
            <Icon
              name="arrow-right"
              size={16}
              class="transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-x-0.5"
            />
          </a>
        )}
        {secondaryCtaEnabled && (
          <a
            href={secondaryCtaUrl}
            class="btn btn-ghost btn-lg group"
            style="border-radius: 8px;"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-strong" aria-hidden="true">
              <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.5" />
              <polygon points="10,8 16,12 10,16" />
            </svg>
            {secondaryCta}
          </a>
        )}
      </div>
      </div>
      {isSplit && (
        <div class:list={[layoutType === "split-left" && "md:order-1"]}>
          {heroImageUrl ? (
            <img
              src={heroImageUrl}
              alt={heroImageAlt}
              class="reveal mx-auto h-auto w-full max-w-2xl rounded-2xl border border-line object-cover shadow-lift"
              data-delay="3"
              loading="eager"
              decoding="async"
            />
          ) : (
            <div class="reveal mx-auto h-72 w-full max-w-2xl rounded-2xl border border-line bg-bg shadow-lift" data-delay="3">
              <div class="flex items-center gap-2 px-4 py-2.5 border-b border-line-soft bg-surface">
                <span class="w-2.5 h-2.5 rounded-full" style="background: oklch(85% 0.16 30);"></span>
                <span class="w-2.5 h-2.5 rounded-full" style="background: oklch(85% 0.13 80);"></span>
                <span class="w-2.5 h-2.5 rounded-full" style="background: oklch(80% 0.18 145);"></span>
              </div>
              <div class="grid h-[calc(100%-42px)] grid-cols-3 gap-3 p-4">
                {Array.from({ length: 6 }).map((_, index) => (
                  <div class="rounded-lg border border-line-soft bg-surface p-3">
                    <span class="block h-2 w-1/2 rounded-full bg-line"></span>
                    <span class="mt-4 block h-2 w-full rounded-full bg-line-soft"></span>
                    <span class="mt-2 block h-2 w-2/3 rounded-full bg-line-soft"></span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      )}
    </div>
  </div>

  <!-- Gradient fade to white -->
  {!isSplit && showCenteredImage && (
    <div
      class="absolute bottom-0 left-0 right-0 h-40 pointer-events-none"
      style="background: linear-gradient(to top, var(--color-bg), transparent);"
      aria-hidden="true"
    ></div>
  )}

  <!-- Product mockup overlapping the gradient -->
  {!isSplit && showCenteredImage && (
  <div class="container-content relative" style="margin-top: -10rem;">
    <div class="reveal mx-auto max-w-5xl" data-delay="3">
      {heroImageUrl ? (
        <img
          src={heroImageUrl}
          alt={heroImageAlt}
          class="h-auto w-full rounded-2xl border border-line object-cover shadow-lift"
          loading="eager"
          decoding="async"
        />
      ) : (
      <div class="bg-bg border border-line rounded-2xl shadow-lift overflow-hidden">
        <!-- Window chrome -->
        <div class="flex items-center gap-2 px-4 py-2.5 border-b border-line-soft bg-surface">
          <span class="w-2.5 h-2.5 rounded-full" style="background: oklch(85% 0.16 30);"></span>
          <span class="w-2.5 h-2.5 rounded-full" style="background: oklch(85% 0.13 80);"></span>
          <span class="w-2.5 h-2.5 rounded-full" style="background: oklch(80% 0.18 145);"></span>
          <span class="flex-1 mx-6 px-3 py-1 rounded-md bg-bg border border-line-soft text-[10px] font-mono text-muted text-center truncate">app.aurora.io/projects</span>
        </div>

        <div class="grid grid-cols-12 min-h-[420px]">
          <!-- Sidebar -->
          <aside class="col-span-2 border-r border-line-soft bg-surface py-4 px-3 flex flex-col gap-0.5">
            <div class="flex items-center gap-2 px-2 mb-4">
              <span class="w-6 h-6 rounded-full aurora-gradient-bg flex items-center justify-center">
                <span class="block w-2 h-2 rounded-full bg-white/90"></span>
              </span>
              <span class="text-[10px] font-bold text-strong tracking-tight">Aurora</span>
            </div>

            <div class="px-2 py-1.5 rounded-md bg-strong text-white text-[10px] font-medium flex items-center gap-1.5">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
              Projects
            </div>
            {["Inbox", "My Tasks", "Calendar", "Reports", "Team"].map((item) => (
              <div class="px-2 py-1.5 rounded-md text-[10px] text-soft">
                {item}
              </div>
            ))}

            <div class="mt-auto pt-3 border-t border-line-soft">
              <div class="flex items-center gap-1.5 px-2">
                <div class="w-5 h-5 rounded-full bg-strong flex items-center justify-center text-[7px] font-bold text-white">AL</div>
                <span class="text-[9px] text-soft truncate">Alex Lin</span>
              </div>
            </div>
          </aside>

          <!-- Main content -->
          <div class="col-span-10 flex flex-col">
            <!-- Top bar -->
            <div class="flex items-center justify-between px-5 py-3 border-b border-line-soft">
              <div class="flex items-center gap-3">
                <span class="text-[13px] font-semibold text-strong">Website Redesign</span>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[9px] font-medium bg-emerald-50 text-emerald-600" style="background: oklch(95% 0.04 155); color: oklch(50% 0.15 155);">
                  <span class="w-1 h-1 rounded-full" style="background: oklch(50% 0.15 155);"></span>
                  On track
                </span>
              </div>
              <div class="flex items-center gap-2">
                <div class="flex -space-x-1.5">
                  {["JD", "MK", "SR"].map((init) => (
                    <div class="w-6 h-6 rounded-full bg-elevated border-2 border-white flex items-center justify-center text-[7px] font-bold text-muted">{init}</div>
                  ))}
                </div>
                <span class="text-[9px] text-muted font-mono">+3</span>
              </div>
            </div>

            <!-- Task board -->
            <div class="flex-1 grid grid-cols-4 gap-0">
              <!-- Backlog -->
              <div class="p-3 border-r border-line-soft">
                <div class="flex items-center justify-between mb-3">
                  <span class="text-[9px] font-medium text-muted uppercase tracking-wider">Backlog</span>
                  <span class="text-[9px] text-muted font-mono">4</span>
                </div>
                <div class="space-y-2">
                  {[
                    { title: "User research synthesis", tag: "Research", color: "oklch(75% 0.12 300)" },
                    { title: "Competitive analysis", tag: "Strategy", color: "oklch(70% 0.12 250)" },
                    { title: "Content audit", tag: "Content", color: "oklch(75% 0.12 70)" },
                    { title: "Accessibility review", tag: "QA", color: "oklch(65% 0.15 145)" },
                  ].map((card) => (
                    <div class="bg-bg border border-line-soft rounded-lg p-2.5">
                      <p class="text-[9px] font-medium text-strong leading-tight">{card.title}</p>
                      <div class="mt-2">
                        <span class="inline-block px-1.5 py-0.5 rounded text-[7px] font-medium" style={`background: ${card.color}18; color: ${card.color};`}>
                          {card.tag}
                        </span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <!-- To Do -->
              <div class="p-3 border-r border-line-soft">
                <div class="flex items-center justify-between mb-3">
                  <span class="text-[9px] font-medium text-muted uppercase tracking-wider">To Do</span>
                  <span class="text-[9px] text-muted font-mono">3</span>
                </div>
                <div class="space-y-2">
                  {[
                    { title: "Design system tokens", tag: "Design" },
                    { title: "Homepage wireframe", tag: "Design" },
                    { title: "Copy for hero section", tag: "Content" },
                  ].map((card) => (
                    <div class="bg-bg border border-line-soft rounded-lg p-2.5">
                      <p class="text-[9px] font-medium text-strong leading-tight">{card.title}</p>
                      <div class="mt-2 flex items-center justify-between">
                        <span class="inline-block px-1.5 py-0.5 rounded text-[7px] font-medium" style="background: oklch(95% 0.02 300); color: oklch(45% 0.02 300);">
                          {card.tag}
                        </span>
                        <div class="w-4 h-4 rounded-full bg-elevated"></div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <!-- In Progress -->
              <div class="p-3 border-r border-line-soft" style="background: oklch(98.5% 0.003 300);">
                <div class="flex items-center justify-between mb-3">
                  <span class="text-[9px] font-medium text-strong uppercase tracking-wider">In Progress</span>
                  <span class="text-[9px] text-strong font-mono">2</span>
                </div>
                <div class="space-y-2">
                  {[
                    { title: "Navigation redesign", tag: "Frontend", avatar: "KM" },
                    { title: "Brand color palette", tag: "Design", avatar: "SR" },
                  ].map((card) => (
                    <div class="bg-bg border border-line rounded-lg p-2.5">
                      <p class="text-[9px] font-medium text-strong leading-tight">{card.title}</p>
                      <div class="mt-2 flex items-center justify-between">
                        <span class="inline-block px-1.5 py-0.5 rounded text-[7px] font-medium" style="background: oklch(18% 0.005 280 / 0.08); color: oklch(30% 0.01 280);">
                          {card.tag}
                        </span>
                        <div class="w-4 h-4 rounded-full bg-strong flex items-center justify-center text-[6px] font-bold text-white">{card.avatar}</div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Done -->
              <div class="p-3">
                <div class="flex items-center justify-between mb-3">
                  <span class="text-[9px] font-medium uppercase tracking-wider" style="color: oklch(50% 0.15 155);">Done</span>
                  <span class="text-[9px] font-mono" style="color: oklch(50% 0.15 155);">5</span>
                </div>
                <div class="space-y-2">
                  {[
                    { title: "Stakeholder interviews" },
                    { title: "Sitemap definition" },
                    { title: "Analytics setup" },
                    { title: "Figma workspace" },
                    { title: "Sprint planning" },
                  ].map((card) => (
                    <div class="bg-surface border border-line-soft rounded-lg p-2.5 opacity-60">
                      <p class="text-[9px] font-medium text-soft leading-tight line-through decoration-line-soft">{card.title}</p>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <!-- Bottom progress bar -->
            <div class="flex items-center gap-4 px-5 py-3 border-t border-line-soft">
              <span class="text-[9px] text-muted">Sprint progress</span>
              <div class="flex-1 h-1.5 bg-elevated rounded-full overflow-hidden">
                <div class="h-full rounded-full bg-strong" style="width: 62%;"></div>
              </div>
              <span class="text-[10px] font-bold text-strong font-mono">62%</span>
            </div>
          </div>
        </div>
      </div>
      )}
    </div>
  </div>
  )}
</section>
