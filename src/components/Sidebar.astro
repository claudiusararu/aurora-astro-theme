---
import Icon from "~/components/Icon.astro";

interface DocsPage {
  group: string;
  title: string;
  description: string;
  bullets: string[];
  command: string;
}

const defaultDocs: DocsPage[] = [
  {
    group: "Getting Started",
    title: "Introduction",
    description:
      "Aurora is a modern project management platform designed for teams that value speed, clarity, and simplicity. This guide will walk you through the core concepts and help you get up and running in minutes.",
    bullets: [
      "How to create your first workspace",
      "Setting up projects and boards",
      "Inviting team members",
      "Configuring automations",
    ],
    command: "npm install @aurora/cli\naurora init my-project\naurora dev",
  },
  {
    group: "Getting Started",
    title: "Installation",
    description: "Install the CLI, connect your account, and start a local workspace in a few commands.",
    bullets: ["Install the package", "Authenticate your workspace", "Run the local dev server"],
    command: "npm install @aurora/cli",
  },
  {
    group: "Core Concepts",
    title: "Projects",
    description: "Projects collect boards, tasks, automations, and reporting into one focused workspace.",
    bullets: ["Organize by workspace", "Customize boards", "Share progress"],
    command: "aurora projects list",
  },
  {
    group: "API Reference",
    title: "Authentication",
    description: "Use API keys and scoped tokens to safely connect Aurora to your product workflow.",
    bullets: ["Create a token", "Scope permissions", "Rotate keys safely"],
    command: "aurora tokens create",
  },
];

const {
  heading = "Documentation",
  subheading = "Everything you need to integrate, customize, and scale Aurora for your team.",
  docsPages = defaultDocs,
} = Astro.props as {
  heading?: string;
  subheading?: string;
  docsPages?: DocsPage[];
};

function withMissingDefaultDocs(items: DocsPage[]) {
  const seen = new Set(items.map((item) => `${item.group}::${item.title}`));
  return [
    ...items,
    ...defaultDocs.filter((item) => !seen.has(`${item.group}::${item.title}`)),
  ];
}

const docs = withMissingDefaultDocs(docsPages.length ? docsPages : defaultDocs);
const groups = Array.from(new Set(docs.map((doc) => doc.group)));
---

<section class="relative py-20 md:py-28">
  <div class="container-content">
    <div class="reveal mb-14 md:mb-18 max-w-2xl">
      <h2
        class="text-[1.8rem] md:text-[2.4rem] font-bold leading-[1.05] text-strong"
        style="letter-spacing: -0.04em;"
      >
        {heading}
      </h2>
      <p class="mt-5 text-[1.05rem] text-soft max-w-[48ch]">
        {subheading}
      </p>
    </div>

    <div
      class="reveal border border-line-soft overflow-hidden"
      style="border-radius: 12px;"
      data-delay="1"
      data-docs-root
    >
      <div class="flex min-h-[480px]">
        <nav
          class="hidden md:block shrink-0 w-[240px] border-r border-line-soft bg-surface py-6 px-4 overflow-y-auto"
          aria-label="Documentation navigation"
        >
          {
            groups.map((group) => (
              <div class={group === groups[0] ? "" : "mt-6"}>
                <h4 class="px-3 text-[11px] font-semibold text-muted uppercase tracking-[0.08em] mb-2">
                  {group}
                </h4>
                <ul class="space-y-0.5">
                  {docs.map((doc, index) => ({ doc, index })).filter(({ doc }) => doc.group === group).map(({ doc, index }) => (
                    <li>
                      <button
                        type="button"
                        class={`aurora-doc-tab block w-full text-left px-3 py-1.5 text-[13px] transition-colors duration-150 ${
                          index === 0 ? "font-semibold text-strong bg-strong/[0.06]" : "text-soft hover:text-strong"
                        }`}
                        style="border-radius: 6px;"
                        aria-current={index === 0 ? "page" : undefined}
                        data-doc-index={index}
                      >
                        {doc.title}
                      </button>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>

        <div class="flex-1 p-8 md:p-10 lg:p-12 bg-bg">
          {docs.map((doc, index) => (
            <article class={`aurora-doc-panel max-w-[65ch] ${index === 0 ? "" : "hidden"}`} data-doc-panel={index}>
              <div class="flex items-center gap-1.5 text-[12px] text-muted mb-6">
                <span>Docs</span>
                <span aria-hidden="true">/</span>
                <span>{doc.group}</span>
                <span aria-hidden="true">/</span>
                <span class="text-strong font-medium">{doc.title}</span>
              </div>

              <h3
                class="text-[1.5rem] md:text-[1.8rem] font-bold text-strong"
                style="letter-spacing: -0.03em;"
              >
                {doc.title}
              </h3>

              <p class="mt-5 text-[15px] leading-relaxed text-soft">
                {doc.description}
              </p>

              {doc.bullets.length ? (
                <>
                  <h4 class="mt-8 text-[1.1rem] font-bold text-strong" style="letter-spacing: -0.02em;">
                    What you'll learn
                  </h4>
                  <ul class="mt-4 space-y-2.5">
                    {doc.bullets.map((item) => (
                      <li class="flex items-start gap-2.5 text-[14px] text-soft">
                        <Icon name="check" size={15} class="shrink-0 mt-0.5 text-strong" stroke={2} />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </>
              ) : null}

              {doc.command ? (
                <div class="mt-8">
                  <div
                    class="bg-strong text-white p-5 font-mono text-[13px] leading-relaxed"
                    style="border-radius: 8px;"
                  >
                    {doc.command.split("\n").filter(Boolean).map((line) => (
                      <>
                        <span class="text-white/50">$</span> {line}<br />
                      </>
                    ))}
                  </div>
                </div>
              ) : null}
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initAuroraDocs() {
    document.querySelectorAll<HTMLElement>("[data-docs-root]").forEach((root) => {
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(".aurora-doc-tab"));
      const panels = Array.from(root.querySelectorAll<HTMLElement>(".aurora-doc-panel"));

      function activate(index: string) {
        tabs.forEach((tab) => {
          const active = tab.dataset.docIndex === index;
          tab.classList.toggle("font-semibold", active);
          tab.classList.toggle("text-strong", active);
          tab.classList.toggle("bg-strong/[0.06]", active);
          tab.classList.toggle("text-soft", !active);
          tab.setAttribute("aria-current", active ? "page" : "false");
        });
        panels.forEach((panel) => {
          panel.classList.toggle("hidden", panel.dataset.docPanel !== index);
        });
      }

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          if (tab.dataset.docIndex) activate(tab.dataset.docIndex);
        });
      });
    });
  }

  initAuroraDocs();
  document.addEventListener("astro:after-swap", initAuroraDocs);
</script>
