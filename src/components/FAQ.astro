---
import Icon from "~/components/Icon.astro";
import { siteConfig } from "~/config/site";

type FaqItem = {
  question?: string;
  answer?: string;
  q?: string;
  a?: string;
};

interface Props {
  heading?: string;
  items?: string;
  faqItems?: FaqItem[];
  contactEnabled?: boolean;
  contactHeading?: string;
  contactDescription?: string;
  contactEmail?: string;
  responseTime?: string;
  contactUrl?: string;
}

const defaultFaqs = siteConfig.faq.items;

const {
  heading = siteConfig.faq.heading,
  items = "",
  faqItems = [],
  contactEnabled = true,
  contactHeading = siteConfig.faq.contactHeading,
  contactDescription = siteConfig.faq.contactDescription,
  contactEmail = siteConfig.faq.contactEmail,
  responseTime = siteConfig.faq.responseTime,
  contactUrl = siteConfig.faq.contactUrl,
} = Astro.props;

const structuredFaqs = faqItems
  .map((item) => ({
    question: (item.question ?? item.q ?? "").trim(),
    answer: (item.answer ?? item.a ?? "").trim(),
  }))
  .filter((item) => item.question || item.answer);

const legacyFaqs = items
  .split("\n")
  .map((line) => line.trim())
  .filter(Boolean)
  .map((line) => {
    const [question = "", ...answerParts] = line.split("|");
    return {
      question: question.trim(),
      answer: answerParts.join("|").trim(),
    };
  })
  .filter((item) => item.question || item.answer);

const faqs = structuredFaqs.length > 0 ? structuredFaqs : legacyFaqs.length > 0 ? legacyFaqs : defaultFaqs;
---

<section id="faq" class="relative py-24 md:py-32">
  <div class="container-content">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      <!-- Left: FAQ accordion (wider) -->
      <div class={contactEnabled ? "lg:col-span-7" : "lg:col-span-8 lg:col-start-3"}>
        <div class="reveal mb-10">
          <h2
            class="text-[1.8rem] md:text-[2.2rem] font-bold leading-[1.05] text-strong"
            style="letter-spacing: -0.04em;"
          >
            {heading}
          </h2>
        </div>

        <div class="divide-y divide-line-soft border-t border-line-soft">
          {
            faqs.map((faq, i) => (
              <details class="reveal group py-5 md:py-6" data-delay={Math.min(i + 1, 6)}>
                <summary class="flex items-start justify-between gap-6 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                  <span class="text-[1rem] md:text-[1.05rem] font-medium text-strong group-hover:opacity-70 transition-opacity duration-200">
                    {faq.question}
                  </span>
                  <span class="shrink-0 mt-0.5 inline-flex items-center justify-center w-6 h-6 text-muted group-open:text-strong transition-colors duration-200">
                    <svg
                      width="12"
                      height="12"
                      viewBox="0 0 12 12"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                    class="group-open:rotate-45 transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)]"
                    aria-hidden="true"
                  >
                      <path d="M6 1v10M1 6h10" />
                    </svg>
                  </span>
                </summary>
                <div class="mt-3 pr-10 text-[14px] leading-relaxed text-soft max-w-[60ch]">
                  {faq.answer}
                </div>
              </details>
            ))
          }
        </div>
      </div>

      <!-- Right: Contact card -->
      {
        contactEnabled && (
          <div class="lg:col-span-5">
            <div class="reveal sticky top-24" data-delay="2">
              <div class="bg-surface p-8 md:p-10" style="border-radius: 12px; border: 1px solid var(--color-line-soft);">
                <h3
                  class="text-[1.2rem] font-bold text-strong"
                  style="letter-spacing: -0.02em;"
                >
                  {contactHeading}
                </h3>
                <p class="mt-3 text-[0.9rem] leading-relaxed text-soft">
                  {contactDescription}
                </p>

                <div class="mt-6 space-y-3">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-elevated flex items-center justify-center" style="border-radius: 8px;">
                      <Icon name="send" size={14} class="text-strong" />
                    </div>
                    <div>
                      <div class="text-[12px] text-muted">Email us at</div>
                      <a href={`mailto:${contactEmail}`} class="text-[14px] font-medium text-strong hover:opacity-70 transition-opacity">
                        {contactEmail}
                      </a>
                    </div>
                  </div>

                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-elevated flex items-center justify-center" style="border-radius: 8px;">
                      <Icon name="clock" size={14} class="text-strong" />
                    </div>
                    <div>
                      <div class="text-[12px] text-muted">Response time</div>
                      <span class="text-[14px] font-medium text-strong">{responseTime}</span>
                    </div>
                  </div>
                </div>

                <a
                  href={contactUrl}
                  class="btn btn-brand btn-lg w-full justify-center mt-8"
                  style="border-radius: 8px;"
                >
                  Contact us
                </a>
              </div>
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
